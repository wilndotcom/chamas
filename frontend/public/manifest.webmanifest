{
  "name": "THE TEAM - Chama Management",
  "short_name": "THE TEAM",
  "description": "Manage a chama's savings, contributions, loans and welfare fund.",

  "_comment_paths": "Every path here is relative on purpose. The manifest is resolved against its own location, so './icon-192.png' is correct whether the app sits at the root of a domain or in a folder such as /the-team/. Absolute '/icon-192.png' resolves to the domain root, which 404s on a sub-path install and makes the app uninstallable. The shortcuts likewise carry the portal prefix, so a member's shortcut does not open an admin page.",
  "start_url": "./",
  "scope": "./",

  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
  "theme_color": "#16a34a",
  "categories": ["finance", "productivity", "business"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Record Contribution",
      "short_name": "Contribute",
      "url": "./admin/contributions",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Loans",
      "short_name": "Loans",
      "url": "./admin/loans",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Notifications",
      "short_name": "Alerts",
      "url": "./admin/notifications",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}